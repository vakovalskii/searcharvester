# Loaded automatically by docker compose via env_file on tavily-adapter.
# Copy to .env.hermes and fill values. .env.hermes is gitignored.
# This file is the sole mechanism for the vars below: they are deliberately
# absent from the environment: list, so a shell export does NOT override them.
# To change a value, edit .env.hermes and recreate the container.
OPENROUTER_API_KEY=
# Parallel /research jobs. Guard budgets are per job, not shared.
MAX_CONCURRENT_JOBS=3
# Loop-guard input-token budget per job (default in guard.py: 3000000).
# The free nvidia/nemotron-3-ultra route burns ~3.5M on a deep run.
GUARD_MAX_INPUT_TOKENS=8000000
# Identical tool-error signature kills the job after N occurrences
# (default 12, across all agents). Extract 422s on hostile pages (GitHub
# issues, forums, JS sites) collapse into one signature regardless of URL,
# so community-source-heavy topics hit 12 fast. Raise for such workloads.
GUARD_SAME_ERROR_STOP=24
